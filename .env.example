# Firebase web app config.
# Copy this file to .env and fill in the values from the Firebase console:
#   Project settings -> General -> Your apps -> SDK setup and configuration
#
# Vite only exposes variables that start with VITE_ to the browser.
# These identify the project publicly and are not secrets; teacher data is
# protected by the Firestore rules in firestore.rules, not by these values.
# .env is gitignored — never commit a real one.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
